{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "${STITCH_API_KEY}"
      }
    }
  },
  "agent": {
    "plan": {
      "model": "ollama-cloud/kimi-k2.7-code"
    },
    "build": {
      "model": "opencode/deepseek-v4-flash-free"
    }
  }
}
